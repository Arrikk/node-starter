PORT=8080
MODE=development
APP_NAME=MyApp
APP_URL=http://localhost:8080
PUBLIC_APP_URL=http://localhost:8080

DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?schema=public
DATABASE_SSLMODE=
DATABASE_SSL_ROOT_CERT=
DATABASE_TRANSACTIONS=true

JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
JWT_REMEMBER_EXPIRES_IN=7d
SALT_ROUNDS=10

REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=app
CACHE_BACKEND=memory

HTTP_LOG=dev

EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL_ADDRESS=noreply@example.com
FROM_USER_NAME=MyApp

STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=uploads
LOCAL_PUBLIC_URL=http://localhost:8080
MAX_FILE_SIZE=104857600
MAX_IMAGE_SIZE=10485760

AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_URL=
AWS_S3_ROLE=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=app

DOMAIN_EVENT_OUTBOX_MAX_ATTEMPTS=5
DOMAIN_EVENT_EMAIL_MAX_ATTEMPTS=5
PASSWORD_RESET_CODE_TTL_MS=3600000
PASSWORD_RESET_CODE_LENGTH=6
