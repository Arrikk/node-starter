{
  "name": "feature-slice-starter",
  "version": "1.0.0",
  "description": "Express + TypeScript feature-slice API starter. PostgreSQL or MySQL, Redis, BullMQ, JWT sessions.",
  "main": "build/app.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p .",
    "start": "node ./build/app.js",
    "dev": "tsx watch src/app.ts --env-file .env",
    "watch": "tsc -p . -w",
    "build-start": "tsc -p . && node ./build/app.js",
    "prisma:generate": "node scripts/prisma-env.mjs generate:all",
    "prisma:generate:pg": "prisma generate --schema prisma/postgresql/schema.prisma",
    "prisma:generate:mysql": "prisma generate --schema prisma/mysql/schema.prisma",
    "prisma:migrate": "node scripts/prisma-env.mjs migrate:dev",
    "prisma:migrate:deploy": "node scripts/prisma-env.mjs migrate:deploy",
    "postinstall": "npm run prisma:generate"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "aws-sdk": "^2.1692.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.3",
    "bullmq": "^5.78.0",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/aws-sdk": "^0.0.42",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.16.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  }
}
